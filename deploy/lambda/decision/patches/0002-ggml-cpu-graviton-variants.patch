diff --git a/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp b/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
index 84a11ea..1c26a21 100644
--- a/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
@@ -3,6 +3,44 @@
 
 #if defined(__aarch64__) || defined(_M_ARM64)
 
+#if defined(GGML_USE_CPU_PART) && defined(__linux__)
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// The host's MIDR_EL1 part number (sysfs, else /proc/cpuinfo); -1 if not an Arm Ltd core or unreadable.
+static int ggml_arm_cpu_part() {
+    unsigned long long midr = 0;
+    FILE * f = fopen("/sys/devices/system/cpu/cpu0/regs/identification/midr_el1", "r");
+    if (f) {
+        int ok = fscanf(f, "%llx", &midr) == 1;
+        fclose(f);
+        if (ok) {
+            return ((midr >> 24) & 0xff) == 0x41 ? (int) ((midr >> 4) & 0xfff) : -1;
+        }
+    }
+    f = fopen("/proc/cpuinfo", "r");
+    if (!f) {
+        return -1;
+    }
+    char line[256];
+    long implementer = -1, part = -1;
+    while (fgets(line, sizeof(line), f) && (implementer < 0 || part < 0)) {
+        const char * colon = strchr(line, ':');
+        if (!colon) {
+            continue;
+        }
+        if (implementer < 0 && strncmp(line, "CPU implementer", 15) == 0) {
+            implementer = strtol(colon + 1, NULL, 0);
+        } else if (part < 0 && strncmp(line, "CPU part", 8) == 0) {
+            part = strtol(colon + 1, NULL, 0);
+        }
+    }
+    fclose(f);
+    return implementer == 0x41 ? (int) part : -1;
+}
+#endif
+
 static int ggml_backend_cpu_aarch64_score() {
     int score = 1;
     const ggml_feats_arch64_runtime_t af = ggml_feats_get_arch64_runtime();
@@ -31,6 +69,15 @@ static int ggml_backend_cpu_aarch64_score() {
 #ifdef GGML_USE_SME
     if (!af.has_sme) { return 0; }
     score += 1<<6;
+#endif
+#ifdef GGML_USE_CPU_PART
+#if defined(__linux__)
+    // A variant for one core: ahead of every generic variant on it, never loaded elsewhere.
+    if (ggml_arm_cpu_part() != (GGML_USE_CPU_PART)) { return 0; }
+    score += 1<<7;
+#else
+    return 0;
+#endif
 #endif
 
     return score;
